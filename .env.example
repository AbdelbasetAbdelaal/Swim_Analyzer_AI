# SwimAnalyzer_AI Environment Configuration

# --------------------------------------------------
# BOOTSTRAP DEMO CREDENTIALS
# --------------------------------------------------
# These variables control the creation of default accounts when the database is first initialized.
# Never use obvious passwords in a production environment.
# Leave these commented out if you do not want demo accounts to be created.

# SWIM_ANALYZER_BOOTSTRAP_ADMIN_USERNAME=your_admin_username
# SWIM_ANALYZER_BOOTSTRAP_ADMIN_PASSWORD=your_strong_password

# SWIM_ANALYZER_BOOTSTRAP_COACH_USERNAME=your_bootstrap_username
# SWIM_ANALYZER_BOOTSTRAP_COACH_PASSWORD=your_bootstrap_password

# --------------------------------------------------
# APPLICATION SETTINGS
# --------------------------------------------------
# ENVIRONMENT=development
# LOG_LEVEL=INFO

# --------------------------------------------------
# OPTIONAL AI COACH LAYER (HUGGING FACE) - STEP 71
# --------------------------------------------------
# Set to 'true' to enable AI-powered coaching interpretations.
# Default is 'false'. The core analysis runs independently without the AI Coach.
SWIM_ANALYZER_AI_COACH_ENABLED=false

# Provider options: 'huggingface' (default), 'disabled', 'mock'
SWIM_ANALYZER_AI_PROVIDER=huggingface

# Hugging Face Model Identifier (default: Qwen/Qwen2.5-1.5B-Instruct)
SWIM_ANALYZER_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Hugging Face User Access Token (Read permission). Never commit actual tokens.
SWIM_ANALYZER_HF_TOKEN=

# Request timeout in seconds for external Hugging Face inference requests
SWIM_ANALYZER_HF_TIMEOUT_SECONDS=20.0

# Optional custom Hugging Face API URL or dedicated inference endpoint
# SWIM_ANALYZER_HF_API_URL=https://api-inference.huggingface.co/models/Qwen/Qwen2.5-1.5B-Instruct
