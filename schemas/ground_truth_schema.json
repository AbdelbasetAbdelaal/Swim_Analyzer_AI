{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swim-analyzer-ai.internal/schemas/ground_truth_schema.json",
  "title": "GroundTruthSampleSchema",
  "description": "Standard machine-readable schema for individual physical ground truth annotation trials in Swim Analyzer AI",
  "type": "object",
  "required": [
    "sample_id",
    "participant_id",
    "session_id",
    "stroke_type",
    "video_id",
    "video_filename",
    "source_type",
    "annotation_version",
    "annotator_id",
    "annotation_timestamp",
    "video_fps",
    "video_duration",
    "frame_count",
    "exclusion_status"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^GT-[A-Z0-9_-]+$",
      "description": "Unique identifier for this ground truth sample (e.g. GT-FREE-001)"
    },
    "participant_id": {
      "type": "string",
      "pattern": "^(PARTICIPANT|SWIMMER|ATHLETE)-[A-Z0-9_-]+$",
      "description": "Pseudonymized participant identifier. Direct PII is strictly forbidden."
    },
    "session_id": {
      "type": "string",
      "description": "Identifier for the recording session or capture protocol"
    },
    "stroke_type": {
      "type": "string",
      "enum": [
        "Freestyle",
        "Backstroke",
        "Breaststroke",
        "Butterfly"
      ],
      "description": "Target swimming style for this trial"
    },
    "video_id": {
      "type": "string",
      "description": "Identifier linking to the raw or preprocessed video asset"
    },
    "video_filename": {
      "type": "string",
      "description": "Filename of the source video"
    },
    "video_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "SHA-256 cryptographic checksum of the raw video asset"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "HIGH_SPEED_OPTICAL_DUAL_RATER",
        "UNDERWATER_QUALISYS_3D_MOCAP",
        "VICON_SUBMERGED_ARRAY",
        "SYNCHRONIZED_IMU_PRESSURE_ARRAY",
        "SYNTHETIC_TEST_FIXTURE"
      ],
      "description": "Origin apparatus for the ground truth measurement"
    },
    "annotation_version": {
      "type": "string",
      "enum": ["1.0.0"],
      "description": "Schema and protocol version used for annotation"
    },
    "annotator_id": {
      "type": "string",
      "description": "Identifier of the primary certified annotator or consensus panel"
    },
    "secondary_annotator_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Identifier of the independent second rater if dual-annotated"
    },
    "annotation_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when annotation was completed"
    },
    "video_fps": {
      "type": "number",
      "minimum": 29.9,
      "description": "True constant frame rate of the video recording"
    },
    "video_duration": {
      "type": "number",
      "minimum": 1.0,
      "description": "Total duration of video trial in seconds"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 30,
      "description": "Total number of frames in the video"
    },
    "pool_context": {
      "type": "object",
      "properties": {
        "pool_length_m": {
          "type": "number",
          "enum": [25.0, 33.33, 50.0]
        },
        "water_type": {
          "type": "string",
          "enum": ["Freshwater", "Chlorinated", "Saltwater"]
        },
        "lane_width_m": {
          "type": "number"
        },
        "camera_position": {
          "type": "string",
          "enum": [
            "Submerged_Window",
            "Submerged_Housing",
            "Poolside_Surface",
            "Poolside_Elevated"
          ]
        },
        "calibration_type": {
          "type": "string",
          "enum": [
            "Metric_Physical_Pool",
            "Submerged_Wand_DLT",
            "Body_Normalized",
            "Uncalibrated"
          ]
        }
      }
    },
    "demographics": {
      "type": "object",
      "properties": {
        "sex": {
          "type": "string",
          "enum": ["Male", "Female", "Unknown"]
        },
        "age_group": {
          "type": "string",
          "enum": ["Junior", "Senior", "Masters", "Elite_Senior"]
        },
        "competition_level": {
          "type": "string",
          "enum": ["Club", "National", "International_Elite", "Recreational"]
        }
      }
    },
    "cycle_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cycle_index",
          "start_frame",
          "end_frame",
          "duration_ms",
          "stroke_rate_spm"
        ],
        "properties": {
          "cycle_index": {
            "type": "integer",
            "minimum": 1
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          },
          "duration_ms": {
            "type": "number",
            "minimum": 100.0
          },
          "stroke_rate_spm": {
            "type": "number",
            "minimum": 10.0,
            "maximum": 120.0
          },
          "phase_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["phase_name", "transition_frame"],
              "properties": {
                "phase_name": {
                  "type": "string"
                },
                "transition_frame": {
                  "type": "integer"
                },
                "timestamp_ms": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "metric_annotations": {
      "type": "object",
      "description": "Standardized ground truth metric values with mandatory source modality and provenance declarations.",
      "properties": {
        "stroke_rate_spm": {
          "type": "object",
          "required": ["source_modality"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "source_modality": {
              "type": "string",
              "enum": [
                "HUMAN_VIDEO_ANNOTATION",
                "PHYSICAL_MOCAP",
                "IMU",
                "CALIBRATED_OPTICAL",
                "SYNTHETIC_TEST_FIXTURE"
              ]
            },
            "temporal_reference": { "type": "string" }
          }
        },
        "cycle_duration_ms": {
          "type": "object",
          "required": ["source_modality"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "source_modality": {
              "type": "string",
              "enum": [
                "HUMAN_VIDEO_ANNOTATION",
                "PHYSICAL_MOCAP",
                "IMU",
                "CALIBRATED_OPTICAL",
                "SYNTHETIC_TEST_FIXTURE"
              ]
            }
          }
        },
        "true_dps_meters": {
          "type": "object",
          "required": ["source_modality"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "source_modality": {
              "type": "string",
              "enum": [
                "PHYSICAL_MOCAP",
                "CALIBRATED_OPTICAL",
                "SYNTHETIC_TEST_FIXTURE"
              ],
              "description": "STRICT CONSTRAINT: Only calibrated physical systems capable of measuring true whole-body translation. HUMAN_VIDEO_ANNOTATION and IMU are strictly forbidden."
            }
          }
        },
        "hand_excursion_proxy_bl": {
          "type": "object",
          "required": ["source_modality"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "source_modality": {
              "type": "string",
              "enum": [
                "HUMAN_VIDEO_ANNOTATION",
                "CALIBRATED_OPTICAL",
                "PHYSICAL_MOCAP",
                "SYNTHETIC_TEST_FIXTURE"
              ]
            }
          }
        },
        "mean_elbow_angle_deg": {
          "type": "object",
          "required": ["source_modality"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "source_modality": {
              "type": "string",
              "enum": [
                "HUMAN_VIDEO_ANNOTATION",
                "PHYSICAL_MOCAP",
                "CALIBRATED_OPTICAL",
                "SYNTHETIC_TEST_FIXTURE"
              ]
            },
            "angle_dimension": {
              "type": "string",
              "enum": ["2D_PLANAR", "3D_SPATIAL"]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "value": { "type": "number" } }
              },
              "then": {
                "required": ["angle_dimension"]
              }
            },
            {
              "if": {
                "properties": { "source_modality": { "const": "HUMAN_VIDEO_ANNOTATION" } }
              },
              "then": {
                "properties": { "angle_dimension": { "const": "2D_PLANAR" } }
              }
            }
          ]
        },
        "mean_knee_angle_deg": {
          "type": "object",
          "required": ["source_modality"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "source_modality": {
              "type": "string",
              "enum": [
                "HUMAN_VIDEO_ANNOTATION",
                "PHYSICAL_MOCAP",
                "CALIBRATED_OPTICAL",
                "SYNTHETIC_TEST_FIXTURE"
              ]
            },
            "angle_dimension": {
              "type": "string",
              "enum": ["2D_PLANAR", "3D_SPATIAL"]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "value": { "type": "number" } }
              },
              "then": {
                "required": ["angle_dimension"]
              }
            },
            {
              "if": {
                "properties": { "source_modality": { "const": "HUMAN_VIDEO_ANNOTATION" } }
              },
              "then": {
                "properties": { "angle_dimension": { "const": "2D_PLANAR" } }
              }
            }
          ]
        },
        "body_roll_amplitude_deg": {
          "type": "object",
          "required": ["source_modality"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "source_modality": {
              "type": "string",
              "enum": [
                "HUMAN_VIDEO_ANNOTATION",
                "PHYSICAL_MOCAP",
                "IMU",
                "CALIBRATED_OPTICAL",
                "SYNTHETIC_TEST_FIXTURE"
              ]
            },
            "angle_dimension": {
              "type": "string",
              "enum": ["2D_PLANAR", "3D_SPATIAL"]
            }
          },
          "if": {
            "properties": { "value": { "type": "number" } }
          },
          "then": {
            "required": ["angle_dimension"]
          }
        },
        "stroke_symmetry_percent": {
          "type": "object",
          "required": ["source_modality"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "source_modality": {
              "type": "string",
              "enum": [
                "HUMAN_VIDEO_ANNOTATION",
                "PHYSICAL_MOCAP",
                "IMU",
                "CALIBRATED_OPTICAL",
                "SYNTHETIC_TEST_FIXTURE"
              ]
            },
            "operational_definition": {
              "type": "string",
              "minLength": 3
            }
          },
          "if": {
            "properties": { "value": { "type": "number" } }
          },
          "then": {
            "required": ["operational_definition"]
          }
        }
      }
    },
    "annotation_notes": {
      "type": "string",
      "description": "Qualitative notes recorded by the human annotator regarding visual conditions or edge cases."
    },
    "quality_flags": {
      "type": "object",
      "properties": {
        "occlusion_level": {
          "type": "string",
          "enum": ["NONE", "LOW", "MEDIUM", "HIGH"]
        },
        "lighting_quality": {
          "type": "string",
          "enum": ["HIGH", "ADEQUATE", "LOW"]
        },
        "water_turbulence": {
          "type": "string",
          "enum": ["CALM", "MODERATE", "SEVERE"]
        },
        "inter_rater_agreement_icc": {
          "type": [
            "number",
            "null"
          ]
        },
        "requires_adjudication": {
          "type": "boolean"
        }
      }
    },
    "exclusion_status": {
      "type": "string",
      "enum": [
        "INCLUDED",
        "AMBIGUOUS",
        "EXCLUDED"
      ],
      "description": "Quality gating status. Only 'INCLUDED' samples may enter official validation cohorts."
    },
    "exclusion_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Detailed explanation if exclusion_status is EXCLUDED or AMBIGUOUS"
    },
    "is_synthetic_fixture": {
      "type": "boolean",
      "default": false,
      "description": "CRITICAL: True ONLY if this sample is a software test mock. Synthetic fixtures must NEVER enter official validation cohorts."
    }
  }
}
